# Foundry endpoints and model deployments
FOUNDRY_OPENAI_ENDPOINT=https://<resource-name>.services.ai.azure.com/openai/v1
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_MODEL_NAME=gpt-4.1
FOUNDRY_COMPARISON_MODEL_NAME=gpt-4.1-mini

# Optional: retain resources created by Labs 05 and 06
FOUNDRY_KEEP_VECTOR_STORE=0
FOUNDRY_KEEP_AGENT=0